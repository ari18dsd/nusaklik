# Optional. Only needed if AI features are enabled.
GEMINI_API_KEY=

# Public URL of the deployed website (optional).
APP_URL=

# Required in production. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional legacy shared master-password login. Prefer database-backed admin accounts.
ADMIN_PASSCODE=

# Required only for the first admin setup on a production deployment without ADMIN_PASSCODE.
# Use a unique random value; the setup endpoint locks after the first admin is created.
ADMIN_SETUP_TOKEN=

# Point these at persistent volumes on the host. Relative paths resolve from the project root.
DATA_DIR=./data
STORAGE_DIR=./storage

# Public HTTP port (hosting platforms usually provide PORT automatically).
PORT=3000

# Configure only for a trusted reverse proxy/load balancer; leave empty for direct local access.
TRUST_PROXY=
